# Copy to .env.local for local development. On Vercel, add these under
# Project Settings > Environment Variables instead.

# Supabase: leave unset to run in demo mode (data stays in this browser).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Google Places API (New) browser key. Leave unset to use OpenStreetMap instead.
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-browser-key
