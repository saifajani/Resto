// Copy this file to Config/Secrets.xcconfig and fill in your values.
// Secrets.xcconfig is gitignored so your keys stay off GitHub.

// Supabase: Project Settings > API. Host only, no "https://".
SUPABASE_HOST = your-project-ref.supabase.co
// The anon / publishable key (safe to ship in the app; row-level security protects the data).
SUPABASE_ANON_KEY = your-anon-or-publishable-key

// Must match the bundle ID you register with Apple and enter in Supabase's Apple provider.
BUNDLE_ID = com.yourname.resto
// Your 10-character Apple Developer Team ID (developer.apple.com > Membership).
DEVELOPMENT_TEAM = ABCDE12345
