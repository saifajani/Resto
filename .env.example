# Copy this file to .env and fill in your values. Never commit a populated env file to git.
#   .env  → local values, loaded by `npm run dev` and `npm run build`.
# On Vercel, set the same variables under Project Settings > Environment Variables.
# All .env* files are git-ignored; only this .env.example is committed.
#
# Leave the Supabase values unset to run in demo mode (data stays in the browser).
# Leave the Google key unset to use OpenStreetMap for restaurants instead.

# Supabase project URL and anon/publishable key (safe to include in client bundles,
# since row-level security protects the data, but keep them out of git anyway)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Google Places API (New) browser key, restricted to your site's addresses
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-browser-key
